# Copy to .env (git-ignored) and fill in your credentials.

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Telegram bot (create one with @BotFather) and the private chat the Sync
# reports to (send it any message, then read the chat id via getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
